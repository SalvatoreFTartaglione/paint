<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>
<?import org.example.model.*?>

<SplitPane fx:id="splitPane" dividerPositions="0.16132264529058116" orientation="VERTICAL" prefHeight="700" prefWidth="1120.0" stylesheets="/org/example/styles/viewStyle.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.MainViewController">
    <items>
        <TabPane fx:id="tabPane" prefHeight="151.0" prefWidth="799.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab fx:id="tabPaneDraw" text="Draw">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="325.0">
                            <children>
                                <Button fx:id="undoButton" layoutX="14.0" layoutY="35.0" onAction="#undoClicked">
                                    <graphic>
                                        <ImageView fx:id="undoImageButton" fitHeight="30.0" fitWidth="30.0" preserveRatio="true">
                                            <image>
                                                <Image url="@../images/undo.png" />
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <ComboBox fx:id="shapeComboBox" layoutX="191.0" layoutY="20.0" prefHeight="25.0" prefWidth="134.0" />
                                <ImageView fx:id="genericShapePhoto" fitHeight="28.0" fitWidth="28.0" layoutX="150.0" layoutY="16.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/genericShapes.png" />
                                    </image>
                                </ImageView>
                                <ComboBox fx:id="favoritesShapeComboBox" layoutX="523.0" layoutY="103.0" prefHeight="25.0" prefWidth="113.0" />
                                <ImageView fx:id="favoritesShapePhoto" fitHeight="28.0" fitWidth="28.0" layoutX="479.0" layoutY="57.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/favorites.png" />
                                    </image>
                                </ImageView>
                                <TextArea fx:id="textArea" layoutX="190.0" layoutY="65.0" prefHeight="38.0" prefWidth="176.0" promptText="Choose 'Text' shape first" />
                                <Label fx:id="warningLabel" layoutX="190.0" layoutY="101.0" textFill="RED" />

                                <ImageView fx:id="genericTextPhoto" fitHeight="29.0" fitWidth="30.0" layoutX="148.0" layoutY="69.0" pickOnBounds="true" preserveRatio="true">
                                   <image>
                                      <Image url="@../images/genericText.png" />
                                   </image>
                                </ImageView>
                                <ComboBox fx:id="fontSizeComboBox" layoutX="370.0" layoutY="74.0" prefHeight="25.0" prefWidth="84.0" promptText="Font">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <Integer fx:value="38" />
                                            <Integer fx:value="46" />
                                            <Integer fx:value="56" />
                                            <Integer fx:value="66" />
                                            <Integer fx:value="76" />
                                            <Integer fx:value="86" />
                                            <Integer fx:value="92" />
                                            <Integer fx:value="100" />
                                            <Integer fx:value="120" />
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                                <ColorPicker fx:id="fillColorPicker" editable="true" layoutX="745.0" layoutY="35.0">
                                    <value>
                                        <Color red="1.0" />
                                    </value>
                                </ColorPicker>
                                <ImageView fx:id="chooseColorPhoto" fitHeight="45.0" fitWidth="53.0" layoutX="687.0" layoutY="51.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/colorPalette.png" />
                                    </image>
                                </ImageView>
                                <Label layoutX="745.0" layoutY="12.0" prefHeight="17.0" prefWidth="121.0" text="Fill color">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Label layoutX="745.0" layoutY="80.0" prefHeight="17.0" prefWidth="122.0" text="Border color">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <ColorPicker fx:id="borderColorPicker" editable="true" layoutX="745.0" layoutY="105.0">
                                    <value>
                                        <Color />
                                    </value>
                                </ColorPicker>

                                <!-- ZOOM -->
                                <Label layoutX="946.0" layoutY="11.0" prefHeight="17.0" prefWidth="80.0" text="Zoom">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Slider fx:id="zoomSlider" layoutX="946.0" layoutY="35.0" majorTickUnit="0.5" max="2.0" min="0.1" minorTickCount="4" prefWidth="120.0" showTickLabels="true" showTickMarks="true" snapToTicks="false" value="1.0" />
                                <Label fx:id="zoomValueLabel" layoutX="976.0" layoutY="79.0" prefHeight="17.0" prefWidth="80.0" text="100%">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                                <Button fx:id="resetZoomButton" layoutX="976.0" layoutY="106.0" mnemonicParsing="false" onAction="#resetZoom" prefWidth="60.0" text="Reset" />
                                <!-- GRID -->
                                <Label layoutX="1159.0" layoutY="6.0" prefHeight="17.0" prefWidth="80.0" text="Grid">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Slider fx:id="gridSlider" layoutX="1154.0" layoutY="34.0" majorTickUnit="20" max="300" min="20" minorTickCount="20" prefWidth="120.0" showTickLabels="true" showTickMarks="true" snapToTicks="false" value="1.0" />
                                <Label fx:id="gridValueLabel" layoutX="1171.0" layoutY="80.0" prefHeight="17.0" prefWidth="80.0" text="100%">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                                <Button fx:id="resetGridButton" layoutX="1176.0" layoutY="105.0" mnemonicParsing="false" onAction="#resetGrid" prefWidth="60.0" text="Reset" />
                                <CheckBox fx:id="checkBoxGrid" layoutX="1204.0" layoutY="8.0" mnemonicParsing="false" onAction="#toggleGrid" />
                        <Button fx:id="saveLibraryButton" layoutX="525.0" layoutY="21.0" mnemonicParsing="false" onAction="#saveLibrary" prefHeight="25.0" prefWidth="97.0" text="Save Library" />
                        <Button layoutX="525.0" layoutY="62.0" mnemonicParsing="false" onAction="#importLibrary" prefHeight="25.0" prefWidth="97.0" text="Import Library" />

                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
                <Tab fx:id="tabPaneFile" text="File">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <Button fx:id="saveButton" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#saveFile" text="Save" />
                                <Button fx:id="loadButton" layoutX="14.0" layoutY="49.0" mnemonicParsing="false" onAction="#loadFile" text="Load" />
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
        <ZoomableScrollPane fx:id="scrollPane" pannable="true" prefHeight="357.0" prefWidth="793.0">
            <Group fx:id="mainCanvasContainer">
                <Pane fx:id="drawingPane" prefHeight="5000.0" prefWidth="5000.0" />
            </Group>
        </ZoomableScrollPane>

    </items>
</SplitPane>
