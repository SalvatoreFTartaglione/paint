<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.Group?>


<?import javafx.scene.canvas.Canvas?>
<?import javafx.collections.FXCollections?>
<?import java.lang.Integer?>
<SplitPane fx:id="splitPane" dividerPositions="0.3" orientation="VERTICAL" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.MainViewController">
    <items>
        <TabPane fx:id="tabPane" prefHeight="151.0" prefWidth="799.0" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab fx:id="tabPaneDraw" text="Draw">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="325.0">
                            <children>
                                <Button fx:id="undoButton" onAction="#undoClicked" layoutX="14.0" layoutY="35.0">
                                    <graphic>
                                        <ImageView fx:id="undoImageButton" fitHeight="30.0" fitWidth="30.0" preserveRatio="true">
                                            <image>
                                                <Image url="@../images/undo.png" />
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                                <ComboBox fx:id="shapeComboBox" layoutX="152.0" layoutY="12.0" prefWidth="150.0"/>
                                <ImageView fx:id="genericShapePhoto" fitHeight="28.0" fitWidth="28.0" layoutX="111.0" layoutY="11.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/genericShapes.png" />
                                    </image>
                                </ImageView>
                                <TextArea fx:id="textArea" layoutX="152.0" layoutY="49.0" prefHeight="33.0" prefWidth="152.0" />
                                <ImageView fx:id="genericTextPhoto" fitHeight="29.0" fitWidth="30.0" layoutX="110.0" layoutY="53.0" pickOnBounds="true" preserveRatio="true">
                                   <image>
                                      <Image url="@../images/genericText.png" />
                                   </image>
                                </ImageView>
                                <ComboBox fx:id="fontSizeComboBox" layoutX="310.0" layoutY="49.0" prefWidth="70.0" promptText="Font">
                                    <items>
                                        <FXCollections fx:factory="observableArrayList">
                                            <Integer fx:value="10"/>
                                            <Integer fx:value="12"/>
                                            <Integer fx:value="14"/>
                                            <Integer fx:value="16"/>
                                            <Integer fx:value="18"/>
                                            <Integer fx:value="24"/>
                                            <Integer fx:value="32"/>
                                            <Integer fx:value="48"/>
                                        </FXCollections>
                                    </items>
                                </ComboBox>
                                <Button fx:id="enterTextButton" onAction="#handleEnterText" layoutX="200.0" layoutY="90.0" mnemonicParsing="false" text="Enter" />
                                <CheckBox fx:id="gridButton" layoutX="310.0" layoutY="95.0" mnemonicParsing="false" text="Show Grid" />
                                <ColorPicker fx:id="fillColorPicker" editable="true" layoutX="466.0" layoutY="27.0">
                                    <value>
                                        <Color red="0.5986841917037964" green="0.5848257541656494" blue="0.5848257541656494" />
                                    </value>
                                </ColorPicker>
                                <ImageView fx:id="chooseColorPhoto" fitHeight="45.0" fitWidth="53.0" layoutX="396.0" layoutY="42.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../images/colorPalette.png" />
                                    </image>
                                </ImageView>
                                <Label layoutX="464.0" layoutY="6.0" prefHeight="17.0" prefWidth="121.0" text="Fill color">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Label layoutX="466.0" layoutY="60.0" prefHeight="17.0" prefWidth="122.0" text="Border color">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <ColorPicker fx:id="borderColorPicker" editable="true" layoutX="466.0" layoutY="82.0">
                                    <value>
                                        <Color />
                                    </value>
                                </ColorPicker>

                                <!-- NUOVA SEZIONE ZOOM -->
                                <Label layoutX="620.0" layoutY="6.0" prefHeight="17.0" prefWidth="80.0" text="Zoom">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Slider fx:id="zoomSlider" layoutX="620.0" layoutY="25.0" prefWidth="120.0"
                                        min="0.1" max="2.0" value="1.0" showTickLabels="true" showTickMarks="true"
                                        majorTickUnit="0.5" minorTickCount="4" snapToTicks="false"/>
                                <Label fx:id="zoomValueLabel" layoutX="620.0" layoutY="55.0" prefHeight="17.0" prefWidth="80.0" text="100%">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                                <Button fx:id="resetZoomButton" layoutX="620.0" layoutY="75.0" mnemonicParsing="false"
                                        onAction="#resetZoom" text="Reset" prefWidth="60.0"/>

                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
                <Tab fx:id="tabPaneFile" text="File">
                    <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                            <children>
                                <Button fx:id="saveButton" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#saveFile" text="Save" />
                                <Button fx:id="loadButton" layoutX="14.0" layoutY="49.0" mnemonicParsing="false" onAction="#loadFile" text="Load" />
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
        <ScrollPane fx:id="scrollPane" pannable="true" prefHeight="357.0" prefWidth="793.0">
            <Group fx:id="mainCanvasContainer">
                <Canvas fx:id="gridCanvas" width="1500.0" height="1500.0" mouseTransparent="true"/>
                <Pane fx:id="drawingPane" prefHeight="1500.0" prefWidth="1500.0"/>
            </Group>
        </ScrollPane>

    </items>
</SplitPane>